FROM node:22-alpine

WORKDIR /app

# Instalar dependencias del sistema y habilitar pnpm
RUN apk add --no-cache libc6-compat
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copiar manifiestos para aprovechar el cache de Docker al instalar dependencias
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY apps/host/package.json ./apps/host/
COPY apps/users/package.json ./apps/users/
COPY packages/design-system/package.json ./packages/design-system/

# Instalar dependencias del monorepo
RUN pnpm install

# Copiar el resto del código
COPY . .

EXPOSE 3001

CMD ["pnpm", "--filter", "users", "dev", "--host", "0.0.0.0", "--port", "3001"]
